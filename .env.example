# Matinee Environment Configuration
# Copy to .env and adjust values as needed

# Server & Network
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Databases & Caches
DATABASE_URL=postgres://postgres:postgres@localhost:5432/matinee
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/matinee_test
DATABASE_URL_READ=postgres://postgres:postgres@localhost:5432/matinee
REDIS_URL=redis://localhost:6379

# Cryptography & Security Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_32_characters_minimum
REFRESH_TOKEN_PEPPER=dev_refresh_token_pepper_32_characters_minimum
TICKET_SIGNING_SECRET=dev_ticket_signing_secret_32_characters_minimum
OPERATOR_API_KEY=dev_operator_api_key_local

# External Integrations (Server-side only)
TMDB_READ_ACCESS_TOKEN=
PAYSTACK_SECRET_KEY=
SENTRY_DSN_SERVER=

# Load Testing Mode (Relaxes IP hold limits for k6 simulation in development)
LOADTEST_MODE=true

# Mobile App Public Configuration (Safe for bundle inclusion, prefix EXPO_PUBLIC_)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SENTRY_DSN_APP=
EXPO_PUBLIC_EAS_PROJECT_ID=
