{
  "expo": {
    "name": "Matinee",
    "slug": "matinee",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "matinee",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
